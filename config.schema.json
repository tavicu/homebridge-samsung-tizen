{
  "pluginAlias": "SamsungTizen",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "disableChildBridges": true,
  "schema": {
    "type": "object",
    "definitions": {
      "inputSource": {
        "type": "string",
        "enum": ["digitalTv", "HDMI1", "HDMI2", "HDMI3", "HDMI4", "HDMI5", "HDMI6", "USB", "USB-C", "Display Port"]
      },
      "input": {
        "type": "object",
        "required": ["name", "type", "value"],
        "properties": {
          "name": {
            "type": "string",
            "required": true
          },
          "type": {
            "type": "string",
            "required": true,
            "enum": ["input", "app", "command"]
          },
          "value": {
            "type": "string",
            "required": true
          }
        }
      },
      "switch": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "required": true
          },
          "power": { "type": "boolean" },
          "mute": { "type": "boolean" },
          "sleep": {
            "type": "integer",
            "minimum": 1
          },
          "volume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "app": { "type": "string" },
          "input": { "$ref": "#/definitions/inputSource" },
          "channel": {
            "type": "integer",
            "minimum": 1
          },
          "picture_mode": { "type": "string" },
          "command": { "type": "string" }
        }
      },
      "keys": {
        "type": "object",
        "properties": {
          "REWIND": { "type": "string" },
          "FAST_FORWARD": { "type": "string" },
          "ARROW_UP": { "type": "string" },
          "ARROW_DOWN": { "type": "string" },
          "ARROW_LEFT": { "type": "string" },
          "ARROW_RIGHT": { "type": "string" },
          "SELECT": { "type": "string" },
          "BACK": { "type": "string" },
          "EXIT": { "type": "string" },
          "PLAY_PAUSE": { "type": "string" },
          "INFORMATION": { "type": "string" }
        }
      },
      "wol": {
        "type": "object",
        "properties": {
          "from": { "type": "string" },
          "address": { "type": "string" },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "interval": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "upnp": {
        "type": "object",
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        }
      }
    },
    "properties": {
      "name": { "type": "string" },
      "clientId": { "type": "string" },
      "clientSecret": { "type": "string" },
      "inputs": {
        "type": "array",
        "items": { "$ref": "#/definitions/input" }
      },
      "switches": {
        "type": "array",
        "items": { "$ref": "#/definitions/switch" }
      },
      "keys": { "$ref": "#/definitions/keys" },
      "wol": { "$ref": "#/definitions/wol" },
      "upnp": { "$ref": "#/definitions/upnp" },
      "devices": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "ip", "mac"],
          "properties": {
            "name": {
              "type": "string",
              "required": true
            },
            "ip": {
              "type": "string",
              "format": "ipv4",
              "required": true
            },
            "mac": {
              "type": "string",
              "required": true,
              "pattern": "^([A-Fa-f0-9]{2}:){5}[A-Fa-f0-9]{2}$"
            },
            "uuid": { "type": "string" },
            "deviceId": { "type": "string" },
            "device_id": { "type": "string" },
            "options": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["Device.Disable", "Switch.DeviceName.Disable"]
              }
            },
            "inputs": {
              "type": "array",
              "items": { "$ref": "#/definitions/input" }
            },
            "switches": {
              "type": "array",
              "items": { "$ref": "#/definitions/switch" }
            },
            "keys": { "$ref": "#/definitions/keys" },
            "wol": { "$ref": "#/definitions/wol" }
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "help",
      "helpvalue": "<div class='alert alert-warning mb-3' role='alert'><h5 class='alert-heading mb-1'><i class='fas fa-exclamation-triangle me-2'></i>Interactive Interface Unavailable</h5><p class='mb-0 small'>This plugin includes a full interactive setup wizard, but it cannot be loaded because you are running an older version of <span class='fw-bold'>Homebridge Config UI X</span>. You are currently viewing the basic configuration editor, which still allows you to manage your devices below. Please update Config UI X to <span class='fw-bold'>v5.27.0</span> or higher to unlock the full custom interface.</p></div>"
    },
    {
      "title": "Devices",
      "key": "devices",
      "type": "array",
      "items": [
        {
          "type": "div",
          "items": [
            {
              "key": "devices[].name",
              "title": "Device Name",
              "placeholder": "Bedroom TV"
            },
            {
              "type": "help",
              "helpvalue": "<p class='help-block'>Make sure that your device has a static IP address. You can set it from your router admin interface!</p>"
            },
            {
              "type": "flex",
              "flex-flow": "row wrap",
              "items": [
                {
                  "key": "devices[].ip",
                  "title": "IP Address",
                  "placeholder": "10.20.30.40"
                },
                {
                  "key": "devices[].mac",
                  "title": "MAC Address",
                  "placeholder": "A0:B1:C2:D3:E4:F5"
                }
              ]
            },
            {
              "key": "devices[].uuid",
              "title": "UUID",
              "placeholder": "A1",
              "description": "If you have problems adding the TV to Home app, set this field to a unique value."
            },
            {
              "key": "devices[].options",
              "title": "Options",
              "titleMap": {
                "Device.Disable": "Disable this device without deleting it",
                "Switch.DeviceName.Disable": "Disable prepending the device name on custom switches"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Inputs",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "type": "help",
          "helpvalue": "<p class='help-block'>These inputs are used by every TV, unless a device has its own list. Source inputs need SmartThings, which is only available in the new configuration interface.</p>"
        },
        {
          "key": "inputs",
          "type": "array",
          "notitle": true,
          "items": [
            {
              "type": "div",
              "items": [
                {
                  "type": "flex",
                  "flex-flow": "row wrap",
                  "items": [
                    {
                      "key": "inputs[].type",
                      "title": "Type",
                      "titleMap": {
                        "input": "Input",
                        "app": "Application",
                        "command": "Command"
                      }
                    },
                    {
                      "key": "inputs[].name",
                      "title": "Input Name",
                      "placeholder": "Netflix"
                    }
                  ]
                },
                {
                  "key": "inputs[].value",
                  "title": "Input Source",
                  "enum": ["digitalTv", "HDMI1", "HDMI2", "HDMI3", "HDMI4", "HDMI5", "HDMI6", "USB", "USB-C", "Display Port"],
                  "titleMap": {
                    "digitalTv": "Digital TV",
                    "HDMI1": "HDMI 1",
                    "HDMI2": "HDMI 2",
                    "HDMI3": "HDMI 3",
                    "HDMI4": "HDMI 4",
                    "HDMI5": "HDMI 5",
                    "HDMI6": "HDMI 6",
                    "USB": "USB",
                    "USB-C": "USB-C",
                    "Display Port": "Display Port"
                  },
                  "condition": {
                    "functionBody": "return model.inputs && model.inputs[arrayIndices[0]] && model.inputs[arrayIndices[0]].type == 'input';"
                  }
                },
                {
                  "key": "inputs[].value",
                  "title": "Application ID",
                  "placeholder": "111299001912",
                  "condition": {
                    "functionBody": "return model.inputs && model.inputs[arrayIndices[0]] && model.inputs[arrayIndices[0]].type == 'app';"
                  }
                },
                {
                  "key": "inputs[].value",
                  "title": "Command",
                  "placeholder": "KEY_VOLUP",
                  "condition": {
                    "functionBody": "return model.inputs && model.inputs[arrayIndices[0]] && model.inputs[arrayIndices[0]].type == 'command';"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Switches",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "type": "help",
          "helpvalue": "<p class='help-block'>These switches are created for every TV, unless a device has its own list. Input source, picture mode and channel need SmartThings, which is only available in the new configuration interface.</p>"
        },
        {
          "key": "switches",
          "type": "array",
          "notitle": true,
          "items": [
            {
              "type": "div",
              "items": [
                {
                  "key": "switches[].name",
                  "title": "Switch Name",
                  "placeholder": "Sleep"
                },
                {
                  "key": "switches[].power",
                  "title": "Power on the TV before running any action"
                },
                {
                  "key": "switches[].mute",
                  "title": "Mute"
                },
                {
                  "type": "flex",
                  "flex-flow": "row wrap",
                  "items": [
                    {
                      "key": "switches[].sleep",
                      "title": "Sleep (minutes)",
                      "placeholder": "60"
                    },
                    {
                      "key": "switches[].volume",
                      "title": "Volume",
                      "placeholder": "10"
                    }
                  ]
                },
                {
                  "type": "flex",
                  "flex-flow": "row wrap",
                  "items": [
                    {
                      "key": "switches[].app",
                      "title": "Application ID",
                      "placeholder": "111299001912"
                    },
                    {
                      "key": "switches[].channel",
                      "title": "Channel",
                      "placeholder": "13"
                    }
                  ]
                },
                {
                  "type": "flex",
                  "flex-flow": "row wrap",
                  "items": [
                    {
                      "key": "switches[].input",
                      "title": "Input Source",
                      "enum": ["digitalTv", "HDMI1", "HDMI2", "HDMI3", "HDMI4", "HDMI5", "HDMI6", "USB", "USB-C", "Display Port"],
                      "titleMap": {
                        "digitalTv": "Digital TV",
                        "HDMI1": "HDMI 1",
                        "HDMI2": "HDMI 2",
                        "HDMI3": "HDMI 3",
                        "HDMI4": "HDMI 4",
                        "HDMI5": "HDMI 5",
                        "HDMI6": "HDMI 6",
                        "USB": "USB",
                        "USB-C": "USB-C",
                        "Display Port": "Display Port"
                      }
                    },
                    {
                      "key": "switches[].picture_mode",
                      "title": "Picture Mode",
                      "placeholder": "modeMovie"
                    }
                  ]
                },
                {
                  "key": "switches[].command",
                  "title": "Command",
                  "placeholder": "KEY_VOLUP"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Remote Keys",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "type": "help",
          "helpvalue": "<p class='help-block'>These mappings are used by every TV, unless a device has its own keys. Leave a field empty to keep the plugin default.</p>"
        },
        {
          "key": "keys.PLAY_PAUSE",
          "title": "Play / Pause",
          "placeholder": "KEY_PLAY_BACK"
        },
        {
          "key": "keys.REWIND",
          "title": "Rewind",
          "placeholder": "KEY_REWIND"
        },
        {
          "key": "keys.FAST_FORWARD",
          "title": "Fast Forward",
          "placeholder": "KEY_FF"
        },
        {
          "key": "keys.ARROW_UP",
          "title": "Arrow Up",
          "placeholder": "KEY_UP"
        },
        {
          "key": "keys.ARROW_DOWN",
          "title": "Arrow Down",
          "placeholder": "KEY_DOWN"
        },
        {
          "key": "keys.ARROW_LEFT",
          "title": "Arrow Left",
          "placeholder": "KEY_LEFT"
        },
        {
          "key": "keys.ARROW_RIGHT",
          "title": "Arrow Right",
          "placeholder": "KEY_RIGHT"
        },
        {
          "key": "keys.SELECT",
          "title": "Select",
          "placeholder": "KEY_ENTER"
        },
        {
          "key": "keys.BACK",
          "title": "Back",
          "placeholder": "KEY_RETURN"
        },
        {
          "key": "keys.EXIT",
          "title": "Exit",
          "placeholder": "KEY_RETURN"
        },
        {
          "key": "keys.INFORMATION",
          "title": "Information",
          "placeholder": "KEY_INFO"
        }
      ]
    }
  ]
}
