<p class="small">
  Please read the <a href="https://tavicu.github.io/homebridge-samsung-tizen/" target="_blank">documentation</a> of the plugin for more informations
  and step by step instructions on how to configure it.
</p>

<div class="mb-4">
  <h5 class="fw-semibold mb-2">SmartThings Integration</h5>

  {% include 'components/smartthings/templates/status-card.tmpl' %}
</div>

<div class="mb-5">
  <div class="d-flex align-items-center justify-content-between mb-2">
    <h5 class="fw-semibold mb-0">Devices</h5>

    {% if config.devices %}
      <button type="button" class="btn btn-primary" data-page="devices"><i class="fas fa-plus"></i> Add device</button>
    {% endif %}
  </div>

  {% include 'components/devices/templates/list-all.tmpl' %}
</div>

<div class="mb-5">
  <div class="d-flex align-items-center justify-content-between mb-2">
    <h5 class="fw-semibold mb-0">Inputs</h5>

    {% if config.inputs %}
      <button type="button" class="btn btn-primary" data-page="inputs"><i class="fas fa-plus"></i> Add input</button>
    {% endif %}
  </div>

  {% include 'components/inputs/templates/list-all.tmpl' %}
</div>

<div>
  <div class="d-flex align-items-center justify-content-between mb-2">
    <h5 class="fw-semibold mb-0">Switches</h5>

    {% if config.switches %}
      <button type="button" class="btn btn-primary" data-page="switch"><i class="fas fa-plus"></i> Add switch</button>
    {% endif %}
  </div>

  {% include 'components/switch/templates/list-all.tmpl' %}
</div>
