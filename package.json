{
  "name": "homebridge-samsung-tizen",
  "displayName": "Homebridge Samsung Tizen",
  "version": "5.3.5",
  "description": "Homebridge plugin for Samsung TV's with Tizen OS",
  "license": "ISC",
  "author": "Octavian Ruda",
  "repository": {
    "type": "git",
    "url": "git://github.com/tavicu/homebridge-samsung-tizen.git"
  },
  "bugs": {
    "url": "https://github.com/tavicu/homebridge-samsung-tizen/issues"
  },
  "homepage": "https://tavicu.github.io/homebridge-samsung-tizen/",
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "homekit",
    "samsung",
    "remote",
    "tizen"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "homebridge-ui/public",
    "homebridge-ui/server.js",
    "config.schema.json"
  ],
  "customUiPath": "./dist/homebridge-ui",
  "scripts": {
    "build": "rimraf dist homebridge-ui/public && tsc && vite build --config homebridge-ui/vite.config.js",
    "watch": "npm run build && npm link && nodemon",
    "watch:ui": "vite build --config homebridge-ui/vite.config.js --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^26.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "copyfiles": "^2.4.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "homebridge": "^2.1.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.2.2",
    "vite-svg-loader": "^5.1.2"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.5",
    "axios": "^1.18.1",
    "deepmerge-ts": "^7.1.5",
    "fast-xml-parser": "^5.9.3",
    "fs-extra": "^11.1.0",
    "is-port-reachable": "^4.0.0",
    "peer-ssdp": "^0.0.5",
    "vue": "^3.5.41",
    "ws": "^8.21.0"
  },
  "overrides": {},
  "funding": [
    {
      "type": "individual",
      "url": "https://www.paypal.com/donate?hosted_button_id=5QLCDRNH77Z9L"
    },
    {
      "type": "individual",
      "url": "https://www.buymeacoffee.com/tavicu"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/tavicu"
    }
  ]
}
