{
    "name": "homebridge-samsung-tizen",
    "displayName": "Homebridge Samsung Tizen",
    "version": "5.2.6",
    "description": "Homebridge plugin for Samsung TV's with Tizen OS",
    "license": "ISC",
    "author": "Octavian Ruda",
    "repository": {
        "type": "git",
        "url": "git://github.com/tavicu/homebridge-samsung-tizen.git"
    },
    "bugs": {
        "url": "https://github.com/tavicu/homebridge-samsung-tizen/issues"
    },
    "homepage": "https://tavicu.github.io/homebridge-samsung-tizen/",
    "keywords": [
        "homebridge-plugin",
        "homebridge",
        "homekit",
        "samsung",
        "remote",
        "tizen"
    ],
    "engines": {
        "homebridge": "^1.8.0 || ^2.0.0-beta.0"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "config.schema.json"
    ],
    "scripts": {
        "lint": "eslint src/**/*.ts --max-warnings=0",
        "watch": "npm run build && npm link && nodemon",
        "build": "rimraf ./dist && tsc && tsc-alias",
        "prepublishOnly": "npm run lint && npm run build"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "eslint": "^8.57.0",
        "homebridge": "^2.0.0-beta.0",
        "nodemon": "^3.1.0",
        "rimraf": "^6.1.0",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.9",
        "typescript": "^6.0.0"
    },
    "dependencies": {
        "deepmerge-ts": "^7.1.5",
        "fs-extra": "^11.1.0",
        "is-port-reachable": "^4.0.0",
        "peer-ssdp": "^0.0.5"
    },
    "overrides": {},
    "funding": [
        {
            "type": "paypal",
            "url": "https://www.paypal.com/donate?hosted_button_id=5QLCDRNH77Z9L"
        },
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/tavicu"
        }
    ]
